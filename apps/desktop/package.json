{
  "name": "desktop",
  "productName": "Moliyaviy yordam",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Moliyaviy yordam — desktop shell (Electron): opens the shared server and runs the Didox robot with this computer's E-IMZO keys.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:mac": "pnpm build && electron-builder --mac --dir",
    "pack:mac:dmg": "pnpm build && electron-builder --mac dmg",
    "pack:win": "pnpm build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/ws": "^8.18.2",
    "electron": "^44.7.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
