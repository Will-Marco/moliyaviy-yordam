generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Firma — shartnomada beruvchi ham, oluvchi ham bo'la oladi (SRS FR-1.2).
/// Manzil, hisob raqami, MFO keyin to'ldirilishi mumkin (Didox importi) — majburiy faqat nom va STIR.
model Company {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  address     String?
  /// STIR (INN), 9 raqam
  tin         String   @unique @db.VarChar(9)
  /// QQS to'lovchi registratsiya kodi, 12 raqam (ixtiyoriy)
  vatRegCode  String?  @map("vat_reg_code") @db.VarChar(12)
  /// Hisob raqami (р/с), 20 raqam
  bankAccount String?  @map("bank_account") @db.VarChar(20)
  /// MFO, 5 raqam
  mfo         String?  @db.VarChar(5)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lentContracts     Contract[] @relation("lender")
  borrowedContracts Contract[] @relation("borrower")

  @@map("companies")
}

/// Moliyaviy yordam shartnomasi (SRS Modul 2). Pul — Decimal, sanalar — faqat sana.
model Contract {
  id            String         @id @default(uuid(7)) @db.Uuid
  number        String         @db.VarChar(50)
  /// Shartnoma imzolangan sana
  signedOn      DateTime       @map("signed_on") @db.Date
  lenderId      String         @map("lender_id") @db.Uuid
  lender        Company        @relation("lender", fields: [lenderId], references: [id], onDelete: Restrict)
  borrowerId    String         @map("borrower_id") @db.Uuid
  borrower      Company        @relation("borrower", fields: [borrowerId], references: [id], onDelete: Restrict)
  /// Jami berilishi mumkin bo'lgan summa (CR-7)
  limitAmount   Decimal        @map("limit_amount") @db.Decimal(18, 2)
  startDate     DateTime       @map("start_date") @db.Date
  endDate       DateTime       @map("end_date") @db.Date
  rateChanges   RateChange[]
  operations    Operation[]
  invoiceDrafts InvoiceDraft[]
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([lenderId, borrowerId, number])
  @@index([borrowerId])
  @@map("contracts")
}

/// Stavkalar tarixi (CR-5). Birinchi yozuv — boshlang'ich stavka, boshlanish sanasidan amal qiladi.
model RateChange {
  id            String   @id @default(uuid(7)) @db.Uuid
  contractId    String   @map("contract_id") @db.Uuid
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// Yillik foiz stavkasi, % (masalan 14.5)
  ratePercent   Decimal  @map("rate_percent") @db.Decimal(7, 4)
  changedOn     DateTime @map("changed_on") @db.Date
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([contractId, effectiveFrom])
  @@map("rate_changes")
}

enum OperationType {
  /// Berildi — asosiy qarzni oshiradi
  DISBURSEMENT
  /// Asosiy qarz qaytarildi — asosiy qarzni kamaytiradi
  PRINCIPAL_REPAYMENT
  /// Foiz to'landi — faqat foiz qarzini kamaytiradi (CR-8)
  INTEREST_PAYMENT

  @@map("operation_type")
}

/// Shartnoma bo'yicha pul harakati (SRS Modul 3). Hisob har doim shulardan qayta hisoblanadi (CR-9).
model Operation {
  id         String        @id @default(uuid(7)) @db.Uuid
  contractId String        @map("contract_id") @db.Uuid
  contract   Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  date       DateTime      @db.Date
  type       OperationType
  amount     Decimal       @db.Decimal(18, 2)
  note       String?       @db.VarChar(500)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([contractId, date])
  @@map("operations")
}

/// Faktura qoralamasi holati (FR-7.4). Yozuv yo'q — "tayyor"; bor — "qoralama yaratildi".
/// Belgilash paytidagi summa saqlanadi: oy qayta hisoblansa, farq ko'rsatiladi.
model InvoiceDraft {
  id              String   @id @default(uuid(7)) @db.Uuid
  contractId      String   @map("contract_id") @db.Uuid
  contract        Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// "yyyy-mm"
  month           String   @db.Char(7)
  amount          Decimal  @db.Decimal(18, 2)
  didoxDocumentId String?  @map("didox_document_id") @db.VarChar(100)
  /// "manual" — marked by hand (M7); "didox" — the app saved it in Didox (M8). CHECK in migration.
  source          String   @default("manual") @db.VarChar(10)
  draftedAt       DateTime @map("drafted_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([contractId, month])
  @@index([month])
  @@map("invoice_drafts")
}
