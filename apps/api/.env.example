DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/moliyaviy_yordam?schema=public"
# Single shared login (SRS FR-1.1)
AUTH_USERNAME="admin"
# Generate with: pnpm hash-password '<password>'  (keep single quotes — the hash contains $)
AUTH_PASSWORD_HASH='$argon2id$...'
# Random 64-char hex: openssl rand -hex 32
JWT_SECRET=""
# Optional: the desktop robot's own key (M13 §4.2) — it signs its session with this, so an unattended run does not
# depend on a person's login. At least 32 chars, not equal to JWT_SECRET. Random: openssl rand -hex 32
# ROBOT_SECRET=""
# "true" behind HTTPS in production
COOKIE_SECURE="true"
PORT=3000
# Number of reverse proxies in front of the API (nginx = 1). 0 when exposed directly.
TRUST_PROXY=0
