# Copy to deploy/.env on the server and fill in. deploy/.env is never committed.

# The domain the accountants open, e.g. hisob.example.uz (its DNS A record points at this server).
# "localhost" only for a local trial.
SITE_ADDRESS=hisob.example.uz
# Leave 80/443 on the server; a local trial can use e.g. 8080/8443.
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=moliyaviy_yordam
POSTGRES_USER=moliyaviy
# Random: openssl rand -hex 24
POSTGRES_PASSWORD=

# The one shared login (SRS FR-1.1). The password is at least 16 characters (M13 §5).
AUTH_USERNAME=admin
# pnpm --filter api hash-password '<password>' — keep the single quotes, the hash contains $
AUTH_PASSWORD_HASH=''
# Random: openssl rand -hex 32. Changing it and restarting the API signs everyone out.
JWT_SECRET=

